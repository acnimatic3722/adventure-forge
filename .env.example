# Copy to .env and fill in. Never commit .env.

# NVIDIA NIM
NVIDIA_API_KEY=

# Prime Intellect / Ollama gateway
PRIME_API_KEY=
OLLAMA_HOST=
OLLAMA_API_KEY=
OLLAMA_KEY=

# Google Gemini (VLM prop detection, dialog + cutscene generation)
GEMINI_API_KEY=

# Hugging Face (model downloads, voice cloning)
HF_TOKEN=

# Media search
FREESOUND_API_KEY=
SERP_API_KEY=

# Pixel art generation
SPRITE_FUSION_API_KEY=

# ---- AdventureForge server --------------------------------------------

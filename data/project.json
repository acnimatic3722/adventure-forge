  "dialogs": [
    {
      "id": "max_banter",
      "name": "Consult Partner Max",
      "npc_name": "Max",
      "root_node": "root",
      "nodes": [
        {
          "id": "root",
          "speaker": "partner",
          "npc_text": "What's on your mind, Sam? My psychic lagomorph senses are tingling!",
          "options": [
            {
              "text": "What do you make of this creepy hotel reception?",
              "reply_text": "Zero room service, dubious floor pizza, and a computer with 4 kilobytes of RAM. Five stars!",
              "next_node": "clues_branch",
              "requires_flag": "",
              "sets_flag": "talked_to_max",
              "gives_item": "",
              "triggers_cutscene": "",
              "once": false
            },
            {
              "text": "Should I pick up that slice of pizza on the rug?",
              "reply_text": "If you don't put it in your inventory within five seconds, I'm eating it, carpet lint and all.",
              "next_node": "__stay__",
              "requires_flag": "",
              "sets_flag": "",
              "gives_item": "",
              "triggers_cutscene": "",
              "once": true
            },
            {
              "text": "Let's get back to poking around.",
              "reply_text": "After you, Sam!",
              "next_node": "__exit__",
              "requires_flag": "",
              "sets_flag": "",
              "gives_item": "",
              "triggers_cutscene": "",
              "once": false
            }
          ]
        },
        {
          "id": "clues_branch",
          "speaker": "partner",
          "npc_text": "Seriously though, Sam, somebody locked up the observatory upstairs and hid the telescope lens.",
          "options": [
            {
              "text": "Why would an astronomer hide their own lens?",
              "reply_text": "Maybe they saw something up there that was looking back at 'em!",
              "next_node": "root",
              "requires_flag": "",
              "sets_flag": "",
              "gives_item": "",
              "triggers_cutscene": "",
              "once": true
            },
            {
              "text": "Enough theories, let's solve this case.",
              "reply_text": "I brought my commemorative brick just in case!",
              "next_node": "__exit__",
              "requires_flag": "",
              "sets_flag": "",
              "gives_item": "",
              "triggers_cutscene": "",
              "once": false
            }
          ]
        }
      ]
    }
  ],
